    }</b>
    Пользователей: <b>{ $users }</b> · устройств: <b>{ $devices }</b>{ $unavailable ->
        [0] {""}
        *[other] {" "}· панель не ответила по { $unavailable }
    }
    .summary-user = <b>{ $name }</b> · <code>{ $telegram_id }</code>
    .summary-outdated = { "  " }• { $title } — { $app } { $installed } → { $latest }
    .summary-stale = { "  " }• { $title } — { unit-day }
