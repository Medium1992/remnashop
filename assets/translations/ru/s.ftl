# Тексты сборки «s» (docs/s/README.md).
# Переопределять их, как и остальные, можно в custom.ftl.

btn-s-reminder =
    .devices = 📱 Мои устройства

ntf-s-versions =
    .outdated =
    <b>📲 Вышло обновление приложения</b>

    { $devices }

    { $sideload ->
    [1]
    ⚠️ <b>Android, сборка с GitHub</b> ставится <b>отдельным приложением</b> рядом со старым и считается новым устройством. Порядок: установите новую версию → добавьте в неё подписку → проверьте, что всё работает → удалите старое приложение → уберите старое устройство в «📱 Мои устройства». Если свободного места нет — добавьте слот там же или напишите в поддержку.

    { ntf-s-versions.footer }
    *[0] { ntf-s-versions.footer }
    }

    .footer = <i>ℹ️ Напоминания об обновлениях приходят не чаще раза в { unit-day } по каждому устройству.</i>

    .line = • <b>{ $title }</b> — { $app } { $installed } → <b>{ $latest }</b>
    .where = { "  " }↳ <a href="{ $url }">{ $label }</a>

ntf-s-stale =
    .reminder =
    <b>🔄 Обновите подписку в приложении</b>

    На этих устройствах подписка давно не обновлялась — там может быть устаревший список серверов и настройки:

    { $devices }

    Откройте <b>{ $apps }</b> и нажмите обновление подписки (🔄 рядом с её названием) или потяните список серверов вниз.

    { $abandoned ->
    [1]
    💡 Если каким-то из этих устройств вы больше не пользуетесь, удалите его в «📱 Мои устройства», чтобы освободить место.

    { ntf-s-stale.footer }
    *[0] { ntf-s-stale.footer }
    }

    .footer = <i>ℹ️ Напоминание приходит не чаще раза в { unit-day } по каждому устройству.</i>

    .line = • <b>{ $title }</b>{ $app ->
        [none] {""}
        *[other] {" "}· { $app }
    } — не обновлялась { unit-day }

btn-s-devices =
    .add-slot = ➕ Добавить устройство

msg-s-devices =
    .slots = 📊 Занято <b>{ $occupied }</b> из <b>{ $limit }</b>.
    .slot-open = ⏱ Открыт слот для нового устройства — осталось { $seconds } сек. Добавьте подписку в приложении на новом устройстве.
    .slot-hint = Чтобы подключить новое устройство, нажмите «➕ Добавить устройство» и в течение { $value } мин. добавьте подписку в приложении.
    .outdated = ⚠️ <b>{ $title }</b>: { $app } { $installed } → <b>{ $latest }</b>
    .stale = ⏳ <b>{ $title }</b>: подписка не обновлялась { unit-day } — обновите её в приложении.

ntf-s-slots =
    .opened = ✅ <b>Слот для устройства открыт</b> на { $value } мин. Добавьте подписку в приложении на новом устройстве — место закрепится за ним автоматически.
    .already-open = ⏱ Слот уже открыт — осталось { $value } сек.
    .free-place = 👌 Свободное место уже есть — просто добавьте подписку на новом устройстве.
    .at-ceiling = 📊 Подключено максимальное для тарифа число устройств: { $value }. Удалите ненужное устройство или смените тариф.
    .unavailable = ⚠️ Не удалось проверить устройства. Попробуйте позже.
    .blocked = 🚫 Подписка сейчас выключена — добавить устройство не получится.
    .consumed = ✅ Новое устройство добавлено, место за ним закреплено.
    .expired = ⏱ Слот закрыт: новое устройство не подключилось за { $value } мин.

